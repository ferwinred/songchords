rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is SuperAdmin or authenticated
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email == 'ferwinred@gmail.com';
    }

    match /songs/{songId} {
      allow read, write: if true;
    }

    match /chords/{chordId} {
      allow read, write: if true;
    }

    match /promo_codes/{codeId} {
      allow read, write: if true;
    }

    match /setlists/{setlistId} {
      allow read, write: if true;
    }
  }
}
